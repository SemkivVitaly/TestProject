<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8.1" />
    </startup>
  <appSettings>
    <!-- Базовый URL веб-интерфейса ESP32-моста (без завершающего /) -->
    <add key="BridgeBaseUrl" value="http://192.168.2.1" />
  </appSettings>
</configuration>